---
import ListingPage from '../../components/ListingPage.astro';
import { getOffers, isActive } from '../../lib/offers';
import { categories, type Category } from '../../site.config';

export function getStaticPaths() {
  // Föräldrar has its own top level page at /nyblivna-foraldrar/
  return categories
    .filter((c) => c.path.startsWith('/kategori/'))
    .map((c) => ({ params: { category: c.slug }, props: { category: c } }));
}

const { category } = Astro.props as { category: Category };
const offers = await getOffers(category.slug);
// Empty categories are thin pages: keep them out of Google (and the sitemap) until they have offers.
const empty = !offers.some((o) => isActive(o));
---

<ListingPage
  title={`${category.heading}.`}
  metaTitle={category.heading}
  description={`${category.intro} Uppdateras löpande på kostaringet.se.`}
  intro={category.intro}
  offers={offers}
  category={category.slug}
  noindex={empty}
  crumbs={[
    { label: 'Alla erbjudanden', href: '/gratis/' },
    { label: category.name, href: category.path },
  ]}
>
  {
    category.slug === 'mat-dryck' && (
      <p class="season">
        Säsong: julmust, julkalendrar och annat som är gratis inför julen finns på sidan
        <a href="/jul/">gratis i jul {new Date().getFullYear()}</a>.
      </p>
    )
  }
</ListingPage>

<style>
  .season {
    margin-top: 32px;
    padding: 16px 20px;
    border-radius: var(--radius);
    background: var(--accent-soft);
    max-width: 46rem;
  }
  .season a {
    font-weight: 700;
    color: var(--accent);
  }
</style>
