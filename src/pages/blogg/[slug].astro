---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import OfferGrid from '../../components/OfferGrid.astro';
import { formatDate, getOffers, isActive } from '../../lib/offers';
import { getPosts, kindLabel, postPath } from '../../lib/posts';
import { categoryBySlug, site } from '../../site.config';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: CollectionEntry<'blogg'> };
const { data } = post;
const { Content } = await render(post);
const category = data.category ? categoryBySlug[data.category] : undefined;
const allOffers = await getOffers();
// Offers named in the post come first; otherwise show what is active in the post's category.
const mentioned = data.offers
  .map((slug) => allOffers.find((o) => o.id === slug))
  .filter((o): o is NonNullable<typeof o> => Boolean(o));
const offers = mentioned.length
  ? mentioned
  : category
    ? allOffers.filter((o) => o.data.category === category.slug && isActive(o)).slice(0, 6)
    : [];
const newer = (await getPosts()).filter((p) => p.id !== post.id).slice(0, 3);

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  inLanguage: 'sv-SE',
  datePublished: data.published.toISOString(),
  dateModified: (data.updated ?? data.published).toISOString(),
  author: { '@type': 'Organization', name: site.name, url: site.url },
  publisher: { '@type': 'Organization', name: site.name, url: site.url },
  mainEntityOfPage: new URL(postPath(post), site.url).href,
};
---

<Base
  title={data.title}
  description={data.description}
  type="article"
  published={data.published}
  modified={data.updated}
  jsonLd={articleLd}
>
  <article class="wrap post">
    <Breadcrumbs
      items={[
        { label: 'Blogg', href: '/blogg/' },
        { label: data.title, href: `/blogg/${post.id}/` },
      ]}
    />
    <header>
      <p class="eyebrow">{kindLabel[data.kind]}</p>
      <h1>{data.title}</h1>
      <p class="lead">{data.description}</p>
      <p class="byline">
        <time datetime={data.published.toISOString()}>{formatDate(data.published)}</time>
        {data.updated && <> · uppdaterad {formatDate(data.updated)}</>}
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
    <AdSlot slot="article" />
  </article>

  {
    offers.length > 0 && (
      <section class="wrap related">
        <div class="section-head">
          <h2>{mentioned.length ? 'Erbjudandena i inlägget.' : 'Aktuellt just nu.'}</h2>
          {category && (
            <a class="more" href={category.path}>
              Alla inom {category.name.toLowerCase()}
            </a>
          )}
        </div>
        <OfferGrid offers={offers} adAfter={0} />
      </section>
    )
  }

  {
    newer.length > 0 && (
      <section class="wrap related">
        <div class="section-head">
          <h2>Fler inlägg.</h2>
          <a class="more" href="/blogg/">
            Alla inlägg
          </a>
        </div>
        <ul class="more-posts">
          {newer.map((p) => (
            <li>
              <a href={postPath(p)}>
                <span class="more-posts__meta">
                  {kindLabel[p.data.kind]} · {formatDate(p.data.published)}
                </span>
                <span class="more-posts__title">{p.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  .post {
    display: grid;
    gap: 28px;
    padding-top: 28px;
  }
  header {
    display: grid;
    gap: 18px;
    max-width: 48rem;
  }
  header h1 {
    font-size: clamp(2.1rem, 5vw, 3.6rem);
  }
  .byline {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .prose {
    margin-top: 8px;
  }
  .related {
    margin-top: 80px;
  }
  .more-posts {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .more-posts a {
    display: grid;
    gap: 4px;
    padding-block: 18px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .more-posts__meta {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .more-posts__title {
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
  }
  .more-posts a:hover .more-posts__title {
    color: var(--accent);
  }
</style>
