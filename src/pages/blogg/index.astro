---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { formatDate } from '../../lib/offers';
import { getPosts, kindLabel, postPath } from '../../lib/posts';

const posts = await getPosts();
---

<Base
  title="Blogg – dagens gratisfynd och guider"
  description="Nya gratisprover, startpaket och provperioder varje dag, plus guider om hur du får ut mest av dem utan att råka betala."
>
  <div class="wrap head">
    <Breadcrumbs items={[{ label: 'Blogg', href: '/blogg/' }]} />
    <h1>Blogg.</h1>
    <p class="lead">Dagens fynd och guider om gratisprover och provperioder – utan att råka betala.</p>
  </div>
  <div class="wrap">
    <ul class="posts">
      {
        posts.map((p) => (
          <li>
            <a href={postPath(p)}>
              <span class="meta">
                <span class:list={['kind', { 'kind--guide': p.data.kind === 'guide' }]}>{kindLabel[p.data.kind]}</span>
                <time datetime={p.data.published.toISOString()}>{formatDate(p.data.published)}</time>
              </span>
              <h2>{p.data.title}</h2>
              <p>{p.data.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .head {
    display: grid;
    gap: 18px;
    padding-block: clamp(32px, 6vw, 72px) 40px;
  }
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .posts a {
    display: grid;
    gap: 8px;
    padding-block: 28px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .posts a:hover h2 {
    color: var(--accent);
  }
  .meta {
    display: flex;
    gap: 10px;
    align-items: center;
    font-size: 0.86rem;
    color: var(--muted);
  }
  .kind {
    font-weight: 650;
    color: var(--accent);
  }
  .kind--guide {
    color: var(--ink-2);
  }
  h2 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(1.5rem, 2.8vw, 2rem);
    letter-spacing: -0.01em;
  }
  .posts p {
    color: var(--ink-2);
    max-width: 44rem;
  }
</style>
