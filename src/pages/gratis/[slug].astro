---
import { existsSync } from 'node:fs';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import OfferGrid from '../../components/OfferGrid.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getOffers, isActive, formatDate, latest, offerPath, outbound, type Offer } from '../../lib/offers';
import { categoryBySlug, offerTypes, site } from '../../site.config';

export async function getStaticPaths() {
  const offers = await getOffers();
  return offers.map((offer) => ({ params: { slug: offer.id }, props: { offer } }));
}

const { offer } = Astro.props as { offer: Offer };
const { data } = offer;
const { Content } = await render(offer);
const active = isActive(offer);
const link = outbound(offer);
const category = categoryBySlug[data.category];

// Similar active offers: same category and type first, then same category, then same type elsewhere.
const score = (o: Offer) => (o.data.category === data.category ? 2 : 0) + (o.data.type === data.type ? 1 : 0);
const related = (await getOffers())
  .filter((o) => o.id !== offer.id && isActive(o) && score(o) > 0)
  .sort((a, b) => score(b) - score(a) || latest(b).getTime() - latest(a).getTime())
  .slice(0, active ? 3 : 6);

const cost =
  data.shipping === 'tillkommer'
    ? 'Gratis, frakt tillkommer'
    : data.shipping > 0
      ? `Gratis, frakt ${data.shipping} kr`
      : '0 kr';
const checkedOn = data.checked ?? latest(offer);
const terms: string[] = [
  data.type === 'provperiod'
    ? 'Gratis under provperioden.'
    : cost === '0 kr'
      ? 'Kostar ingenting, inte heller frakt.'
      : `${cost}.`,
  ...data.requirements.map((r) => (/[.!?]$/.test(r) ? r : `${r}.`)),
  ...(data.type === 'provperiod'
    ? ['Provperioden blir en betald prenumeration om du inte säger upp den innan den tar slut.']
    : []),
  data.expires ? `Gäller till och med ${formatDate(data.expires)}.` : 'Inget slutdatum angivet.',
];
const facts: [string, string][] = [
  ['Typ', offerTypes[data.type]],
  ['Kostnad', cost],
  ['Krav', data.requirements.length ? data.requirements.join(' · ') : 'Inga särskilda krav'],
  ['Giltigt till', data.expires ? formatDate(data.expires) : 'Tills vidare'],
  ['Senast kontrollerad', formatDate(data.checked ?? latest(offer))],
];

// Free trials turn into paid subscriptions, so they are not marked up as free products.
const productLd = data.type === 'provperiod' || !active ? undefined : {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: data.title,
  description: data.description,
  brand: { '@type': 'Brand', name: data.brand },
  category: category.name,
  url: new URL(offerPath(offer), site.url).href,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'SEK',
    url: data.url,
    availability: active ? 'https://schema.org/InStock' : 'https://schema.org/Discontinued',
    ...(data.expires && { priceValidUntil: data.expires.toISOString().slice(0, 10) }),
    ...(typeof data.shipping === 'number' && data.shipping > 0 && {
      shippingDetails: {
        '@type': 'OfferShippingDetails',
        shippingRate: { '@type': 'MonetaryAmount', value: String(data.shipping), currency: 'SEK' },
        shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'SE' },
      },
    }),
  },
};
// Own share image from `npm run og`, otherwise the site default.
const ogImage = existsSync(`public/og/${offer.id}.png`) ? `/og/${offer.id}.png` : undefined;
---

<Base
  title={data.seoTitle ?? data.title}
  image={ogImage}
  description={data.description}
  type="article"
  published={data.published}
  modified={latest(offer)}
  jsonLd={productLd}
>
  <div class="wrap">
    <div class="head">
      <Breadcrumbs
        items={[
          { label: category.name, href: category.path },
          { label: data.brand, href: offerPath(offer) },
        ]}
      />
    </div>

    <div class="layout">
      <article class="main">
        <p class="eyebrow">{data.brand} · {category.name}</p>
        <h1>{data.title}</h1>
        <p class="lead">{data.description}</p>
        <p class="checked">
          Kontrollerat på företagets egen sida <time datetime={checkedOn.toISOString()}>{formatDate(checkedOn)}</time>.{' '}
          <a href="/sa-kontrollerar-vi/">Så kontrollerar vi</a>
        </p>
        {
          active && (
            <p class="mobile-cta">
              <a class="btn" href={link.href} rel={link.rel} target="_blank">
                Till erbjudandet <span aria-hidden="true">↗</span>
              </a>
              {link.sponsored && <span class="adlabel">Annonslänk</span>}
            </p>
          )
        }

        {
          !active && (
            <div class="notice" role="status">
              <p>
                <strong>Erbjudandet är slut.</strong> När vi kontrollerade det {formatDate(latest(offer))} fanns det inte
                längre kvar. Kommer det tillbaka uppdaterar vi sidan.
              </p>
              {related.length > 0 && (
                <p>
                  Gäller just nu i stället:{' '}
                  {related.slice(0, 3).map((o, i) => (
                    <>
                      {i > 0 && (i === Math.min(related.length, 3) - 1 ? ' och ' : ', ')}
                      <a href={offerPath(o)}>{o.data.brand}</a>
                    </>
                  ))}
                  .
                </p>
              )}
            </div>
          )
        }

        <section class="terms" aria-labelledby="villkor">
          <h2 id="villkor">Villkor i korthet</h2>
          <ul>
            {terms.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </section>

        <div class="prose">
          <Content />
        </div>

        <AdSlot slot="article" />

        <p class="byline">
          Publicerad <time datetime={data.published.toISOString()}>{formatDate(data.published)}</time>
          {
            data.updated && (
              <>
                {' '}· uppdaterad <time datetime={data.updated.toISOString()}>{formatDate(data.updated)}</time>
              </>
            )
          }
        </p>
      </article>

      <aside class="side">
        <div class="facts">
          <dl>
            {
              facts.map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))
            }
          </dl>
          {
            active ? (
              <a class="btn facts__cta" href={link.href} rel={link.rel} target="_blank">
                Till erbjudandet hos {data.brand}
                <span aria-hidden="true">↗</span>
              </a>
            ) : (
              <span class="facts__ended">Avslutat</span>
            )
          }
          <p class="facts__small">
            {link.sponsored && (
              <>
                <strong>Annonslänk.</strong> Vi kan få ersättning om du beställer via länken. Det kostar inget extra och
                påverkar inte vilka erbjudanden vi skriver om.{' '}
              </>
            )}
            Du beställer direkt hos {data.brand}. Kontrollera alltid villkoren innan du lämnar dina uppgifter.
          </p>
        </div>
        <AdSlot slot="sidebar" />
      </aside>
    </div>

    {
      related.length > 0 && (
        <section class="related">
          <div class="section-head">
            <h2>{active ? 'Liknande erbjudanden.' : 'Gäller just nu i stället.'}</h2>
            <a class="more" href={category.path}>
              Visa alla
            </a>
          </div>
          <OfferGrid offers={related} adAfter={0} />
        </section>
      )
    }
  </div>
</Base>

<style>
  .checked {
    font-size: 0.9rem;
    color: var(--muted);
  }
  .terms {
    margin-block: 8px 24px;
    padding: 18px 20px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .terms h2 {
    font-size: 1.1rem;
    margin-bottom: 8px;
  }
  .terms ul {
    margin: 0;
    padding-left: 1.1em;
    display: grid;
    gap: 4px;
    color: var(--ink-2);
  }
  .head {
    padding-top: 28px;
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: clamp(32px, 5vw, 72px);
    padding-top: 28px;
    align-items: start;
  }
  .main {
    display: grid;
    gap: 20px;
    min-width: 0;
  }
  .main h1 {
    font-size: clamp(2rem, 4.6vw, 3.25rem);
  }
  .notice p + p {
    margin-top: 8px;
  }
  .notice {
    padding: 14px 18px;
    border-radius: var(--radius-sm);
    background: var(--surface);
    border: 1px solid var(--line-strong);
  }
  .mobile-cta {
    display: none;
    align-items: center;
    gap: 12px;
    justify-self: start;
  }
  .adlabel {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .byline {
    font-size: 0.88rem;
    color: var(--muted);
  }
  .side {
    position: sticky;
    top: 92px;
  }
  .facts {
    display: grid;
    gap: 18px;
    padding: 22px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  dl {
    margin: 0;
    display: grid;
  }
  dl > div {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 12px;
    padding-block: 10px;
    border-bottom: 1px solid var(--line);
    font-size: 0.94rem;
  }
  dt {
    color: var(--muted);
  }
  dd {
    margin: 0;
    font-weight: 600;
  }
  .facts__cta {
    justify-content: center;
    text-align: center;
  }
  .facts__ended {
    text-align: center;
    padding: 14px;
    border-radius: 999px;
    border: 1px dashed var(--line-strong);
    color: var(--muted);
    font-weight: 600;
  }
  .facts__small {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .related {
    margin-top: 80px;
  }
  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .mobile-cta {
      display: flex;
    }
    .side {
      position: static;
    }
  }
</style>
