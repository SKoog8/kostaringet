---
import TextPage from '../layouts/TextPage.astro';
import { site } from '../site.config';

const subject = encodeURIComponent('Tips på gratiserbjudande');
const body = encodeURIComponent('Länk till erbjudandet:\n\nVad får man?\n\nKostar något (frakt, medlemskap)?\n');
---

<TextPage
  title="Tipsa om ett gratiserbjudande"
  path="/tipsa/"
  description="Har du hittat ett gratisprov eller ett prova på-erbjudande? Tipsa kostaringet.se så lägger vi upp det."
>
  <p>
    Har du sett ett gratisprov, en babybox eller en provperiod som inte finns här? Skicka länken så kollar vi
    den och lägger upp den.
  </p>
  <p>
    <a class="btn" href={`mailto:${site.email}?subject=${subject}&body=${body}`}>Mejla ett tips</a>
  </p>
  <p>Skriv gärna med om erbjudandet kostar frakt, kräver medlemskap eller har ett slutdatum.</p>
</TextPage>
