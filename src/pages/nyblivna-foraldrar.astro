---
import ListingPage from '../components/ListingPage.astro';
import ProductBox from '../components/ProductBox.astro';
import { getOffers, isActive, offerPath, formatDate } from '../lib/offers';
import { categoryBySlug, offerTypes } from '../site.config';

const category = categoryBySlug.foraldrar;
const offers = await getOffers('foraldrar');
const year = new Date().getFullYear();
const active = offers.filter((o) => isActive(o));
const cost = (o: (typeof offers)[number]) =>
  o.data.shipping === 'tillkommer' ? 'Frakt tillkommer' : o.data.shipping > 0 ? `Frakt ${o.data.shipping} kr` : 'Gratis';

const faq = [
  {
    q: 'När ska jag beställa babyboxar?',
    a: 'De flesta startpaket kan beställas från ungefär vecka 20 av graviditeten och fram till att barnet är några månader. Beställ gärna tidigt – flera paket har begränsade upplagor.',
  },
  {
    q: 'Är babyboxarna verkligen gratis?',
    a: 'Innehållet är gratis, men vissa tar ut en fraktavgift eller kräver att du hämtar paketet i butik. Vi skriver alltid ut frakt och krav på varje erbjudande.',
  },
  {
    q: 'Varför ger företag bort saker till nyblivna föräldrar?',
    a: 'Föräldrar till nyfödda väljer nya märken för blöjor, hudvård och barnmat. Företagen hoppas att du fortsätter köpa det du provat. Var därför uppmärksam på vilka nyhetsbrev du tackar ja till.',
  },
  {
    q: 'Behöver jag lämna personnummer?',
    a: 'Oftast räcker namn, adress och beräknat förlossningsdatum. Vissa butiker vill se legitimation när du hämtar ut paketet. Lämna aldrig kortuppgifter för ett paket som ska vara gratis.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<ListingPage
  title={`${category.heading}.`}
  metaTitle={`Gratis babyboxar och babypaket ${year}`}
  description={`Alla gratis babyboxar, startpaket och blöjprover för gravida och nyblivna föräldrar ${year}. Se vad som ingår, vad frakten kostar och hur länge du kan beställa.`}
  intro={category.intro}
  offers={offers}
  category="foraldrar"
  crumbs={[{ label: category.name, href: category.path }]}
>
  <article class="guide prose">
    <h2>Gratis babyboxar {year}: så fungerar det</h2>
    <p>
      Få livshändelser ger så många gratispaket som att vänta barn. Blöjtillverkare, babybutiker, apotek och bokklubbar
      vet att nyblivna föräldrar väljer nya märken, och de vill gärna vara först. Här är alla paket som går att få just
      nu, och vad du ska tänka på innan du beställer. Varje paket är kontrollerat hos företaget, och datumet för den
      senaste kontrollen står på erbjudandets sida.
    </p>

    <h3>Alla paket i en tabell</h3>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Paket</th><th>Typ</th><th>Kostnad</th><th>Bra att veta</th></tr>
        </thead>
        <tbody>
          {
            active.map((o) => (
              <tr>
                <td><a href={offerPath(o)}>{o.data.brand}</a></td>
                <td>{offerTypes[o.data.type]}</td>
                <td>{cost(o)}</td>
                <td>{o.data.requirements[0] ?? (o.data.expires ? `Gäller till ${formatDate(o.data.expires)}` : 'Inga krav')}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <h3>När ska man beställa?</h3>
    <p>De flesta babyboxar och startpaket går att beställa från ungefär halva graviditeten. En bra tumregel:</p>
    <ul>
      <li><strong>Vecka 20–30:</strong> beställ babyboxar och gå med i blöjklubbar. Då hinner du hämta ut allt i lugn och ro, och du missar inte paket med begränsad upplaga.</li>
      <li><strong>Efter förlossningen:</strong> registrera barnets födelsedatum i klubbarna. Då kommer ofta en ny gåva.</li>
      <li><strong>3–6 månader:</strong> håll utkik efter provpaket på barnmat och nästa storlek blöjor.</li>
    </ul>
    <p>Vissa paket måste hämtas i butik inom en viss tid efter beställningen. Det står på varje erbjudande.</p>

    <h3>Tre sorters gratispaket</h3>
    <p>
      <strong>Startpaket och babyboxar</strong> är lådor med varuprover och erbjudanden från flera varumärken. De är
      oftast helt gratis om du hämtar dem i butik, medan hemleverans kan kosta en avgift.
    </p>
    <p>
      <strong>Klubbar och medlemsgåvor</strong> kräver att du skapar ett konto. Medlemskapet är gratis, och i gengäld får
      varumärket skicka erbjudanden till dig.
    </p>
    <p>
      <strong>Välkomstpaket som startar en prenumeration</strong> är där du behöver vara uppmärksam. Paketet är gratis,
      men nästa leverans är det inte. Läs alltid hur du avslutar innan du beställer.
    </p>

    <h3>Så undviker du fällorna</h3>
    <ol>
      <li><strong>Lämna aldrig kortuppgifter</strong> för något som ska vara gratis, om det inte gäller en frakt du har accepterat.</li>
      <li><strong>Använd en separat mejladress</strong> för klubbar och babyboxar. Utskicken blir många.</li>
      <li><strong>Kryssa ur samtycken</strong> till marknadsföring från partner. Det påverkar sällan om du får paketet.</li>
      <li><strong>Skriv upp slutdatum</strong> i kalendern samma dag som du beställer något som kan bli en prenumeration.</li>
    </ol>
  </article>

  <ProductBox slug="blojfri-pa-7-dagar" />

  <section class="faq">
    <h2>Vanliga frågor.</h2>
    <dl>
      {
        faq.map((f) => (
          <div>
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </div>
        ))
      }
    </dl>
    <a class="more" href="/guide/pottraning/">Läs också: så kommer ni igång med pottträningen</a>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</ListingPage>

<style>
  .guide {
    margin-top: 72px;
    max-width: 46rem;
  }
  .table-wrap {
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  th,
  td {
    text-align: left;
    padding: 10px 12px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  th {
    font-weight: 700;
  }
  .faq {
    margin-top: 72px;
    display: grid;
    gap: 24px;
    max-width: 46rem;
  }
  dl {
    margin: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }
  dl > div {
    padding-block: 18px;
    border-bottom: 1px solid var(--line);
  }
  dt {
    font-weight: 700;
    font-size: 1.08rem;
    margin-bottom: 6px;
  }
  dd {
    margin: 0;
    color: var(--ink-2);
  }
</style>
