---
import { offerTypes } from '../site.config';
import Illustration from './Illustration.astro';
import { isActive, offerPath, formatShort, latest, type Offer } from '../lib/offers';

interface Props {
  offer: Offer;
  headingLevel?: 'h2' | 'h3';
}

const { offer, headingLevel: H = 'h3' } = Astro.props;
const { data } = offer;
const active = isActive(offer);
const shippingNote =
  data.shipping === 'tillkommer' ? 'Frakt tillkommer' : data.shipping > 0 ? `Frakt ${data.shipping} kr` : null;
const note = shippingNote ?? data.requirements[0] ?? 'Inga krav';
---

<article class:list={['card', { 'card--ended': !active }]} data-category={data.category}>
  <div class="card__top">
    <Illustration cat={data.category} size={44} class="card__il" />
    <span class="card__brand">{data.brand}</span>
    {active ? <span class="tag">{offerTypes[data.type]}</span> : <span class="tag tag--muted">Avslutat</span>}
  </div>
  <H class="card__title">
    <a href={offerPath(offer)}>{data.title}</a>
  </H>
  <p class="card__desc">{data.description}</p>
  <div class="card__meta">
    <span class="card__note">{note}</span>
    <span class="card__date">
      <time datetime={latest(offer).toISOString()}>{formatShort(latest(offer))}</time>
    </span>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color 0.15s, transform 0.15s;
  }
  .card:hover {
    border-color: var(--ink);
  }
  .card__top {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .card__brand {
    font-weight: 650;
    font-size: 0.92rem;
    color: var(--ink-2);
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .card__title {
    font-size: 1.18rem;
    line-height: 1.22;
  }
  .card__title a {
    text-decoration: none;
  }
  /* Whole card clickable, while keeping a single real link for accessibility */
  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .card__desc {
    color: var(--ink-2);
    font-size: 0.95rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card__meta {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px dashed var(--line);
    display: flex;
    gap: 12px;
    font-size: 0.84rem;
    color: var(--muted);
  }
  .card__note {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .card__date {
    flex: none;
  }
  .card--ended {
    background: transparent;
  }
  .card--ended :global(.card__il) {
    filter: grayscale(1);
    opacity: 0.6;
  }
  .card--ended .card__title,
  .card--ended .card__desc {
    color: var(--ended);
  }
</style>
