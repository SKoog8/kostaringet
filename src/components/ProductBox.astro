---
// "Från oss" box for one of our own products. Clearly labelled so it is never
// confused with the free offers.
import { productBySlug } from '../site.config';

interface Props {
  slug: string;
  /** Hide the free sample link, e.g. on the free sample page itself. */
  hideFreebie?: boolean;
}

const product = productBySlug[Astro.props.slug];
const freebie = Astro.props.hideFreebie ? undefined : product?.freebie;
---

{
  product && (
    <aside class="product" aria-label={`Från oss: ${product.title}`}>
      <a class="product__img" href={product.url} target="_blank" rel="noopener">
        <img src={product.image} alt={product.imageAlt} width="320" height="320" loading="lazy" decoding="async" />
      </a>
      <div class="product__body">
        <p class="product__label">Från oss</p>
        <h2 class="product__title">{product.title}</h2>
        <p class="product__tagline">{product.tagline}</p>
        <ul class="product__list">
          {product.includes.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <div class="product__buy">
          <a class="btn" href={product.url} target="_blank" rel="noopener">
            Köp på Etsy · {product.price} <span aria-hidden="true">↗</span>
          </a>
          <span class="product__format">{product.format}</span>
        </div>
        {freebie && (
          <p class="product__freebie">
            Vill du prova först? <a href={freebie.page}>{freebie.title}</a>, gratis att ladda ner.
          </p>
        )}
        <p class="product__note">
          Det här är vår egen guide, och den kostar pengar. Den säljs via Etsy, där du betalar och laddar ner den.
        </p>
      </div>
    </aside>
  )
}

<style>
  .product {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: clamp(20px, 3vw, 36px);
    align-items: start;
    margin-block: 48px;
    padding: clamp(20px, 3vw, 32px);
    border-radius: calc(var(--radius) * 1.5);
    background: var(--surface);
    border: 1px solid var(--line-strong);
  }
  .product__img {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--accent-soft);
    aspect-ratio: 1;
  }
  .product__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product__body {
    display: grid;
    gap: 12px;
    min-width: 0;
  }
  .product__label {
    justify-self: start;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--cat-foraldrar-bg);
    color: var(--cat-foraldrar-fg);
  }
  .product__title {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }
  .product__tagline {
    color: var(--ink-2);
  }
  .product__list {
    margin: 0;
    padding-left: 1.1em;
    display: grid;
    gap: 4px;
    font-size: 0.95rem;
    color: var(--ink-2);
  }
  .product__buy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    margin-top: 6px;
  }
  .product__format {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .product__freebie {
    font-size: 0.95rem;
  }
  .product__freebie a {
    font-weight: 700;
  }
  .product__note {
    font-size: 0.82rem;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .product {
      grid-template-columns: 1fr;
    }
    .product__img {
      max-width: 240px;
    }
  }
</style>
