---
// Kontaktformulär som skickar till /api/contact/ (Vercel-funktion som mejlar via Resend).
interface Props {
  topic?: 'kontakt' | 'tips';
  label?: string;
  placeholder?: string;
}
const { topic = 'kontakt', label = 'Meddelande', placeholder = '' } = Astro.props;
---

<form class="contact-form" data-contact-form novalidate>
  <input type="hidden" name="topic" value={topic} />
  <div class="field">
    <label for={`cf-name-${topic}`}>Namn <span class="opt">(valfritt)</span></label>
    <input id={`cf-name-${topic}`} name="name" type="text" maxlength="100" autocomplete="name" />
  </div>
  <div class="field">
    <label for={`cf-email-${topic}`}>Din e-post</label>
    <input id={`cf-email-${topic}`} name="email" type="email" required maxlength="200" autocomplete="email" />
  </div>
  <div class="field">
    <label for={`cf-message-${topic}`}>{label}</label>
    <textarea id={`cf-message-${topic}`} name="message" required minlength="10" maxlength="5000" rows="6" placeholder={placeholder}></textarea>
  </div>
  <!-- Fälla för botar: dold för människor, så ett ifyllt värde betyder spam. -->
  <div class="hp" aria-hidden="true">
    <label for={`cf-website-${topic}`}>Lämna tomt</label>
    <input id={`cf-website-${topic}`} name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <p class="status" role="status" aria-live="polite"></p>
  <div class="actions">
    <button class="btn" type="submit">Skicka</button>
    <span class="note">Vi använder bara dina uppgifter för att svara. Se <a href="/integritetspolicy/">integritetspolicyn</a>.</span>
  </div>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.className = 'status';
      if (!form.checkValidity()) {
        status.textContent = 'Fyll i en giltig e-postadress och ett meddelande på minst 10 tecken.';
        status.classList.add('is-error');
        return;
      }
      button.disabled = true;
      button.textContent = 'Skickar …';
      try {
        const res = await fetch('/api/contact/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'Meddelandet kunde inte skickas.');
        form.reset();
        form.classList.add('is-sent');
        status.textContent = 'Tack! Ditt meddelande är skickat. Vi svarar till e-postadressen du angav.';
        status.classList.add('is-ok');
      } catch (err) {
        status.textContent = err instanceof Error ? err.message : 'Meddelandet kunde inte skickas.';
        status.classList.add('is-error');
      } finally {
        button.disabled = false;
        button.textContent = 'Skicka';
      }
    });
  });
</script>

<style>
  .contact-form {
    display: grid;
    gap: 16px;
    max-width: 36rem;
    margin-block: 8px 24px;
    padding: clamp(18px, 3vw, 28px);
    border: 1px solid var(--line-strong);
    border-radius: calc(var(--radius) * 1.5);
    background: var(--surface);
    font-family: var(--font-sans);
    position: relative;
  }
  .field {
    display: grid;
    gap: 6px;
  }
  label {
    font-weight: 650;
    font-size: 0.95rem;
  }
  .opt {
    font-weight: 400;
    color: var(--muted);
  }
  input,
  textarea {
    width: 100%;
    font: inherit;
    font-size: 1rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    padding: 10px 12px;
  }
  input:focus,
  textarea:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: var(--accent);
  }
  textarea {
    resize: vertical;
    min-height: 8rem;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
  }
  .note {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .status:empty {
    display: none;
  }
  .status {
    margin: 0;
    font-weight: 600;
  }
  .status.is-ok {
    color: var(--accent);
  }
  .status.is-error {
    color: #b3261e;
  }
  button:disabled {
    opacity: 0.6;
    cursor: wait;
  }
</style>
