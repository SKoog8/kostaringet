---
import Logo from './Logo.astro';
import { nav } from '../site.config';

const current = Astro.url.pathname;
const isCurrent = (href: string) => current === href || current.startsWith(href);
---

<header class="header">
  <div class="wrap header__inner">
    <a href="/" class="header__logo" aria-label="kostaringet.se – till startsidan">
      <Logo />
    </a>
    <nav aria-label="Huvudmeny">
      <ul class="header__nav">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--line);
    background: var(--paper);
    position: sticky;
    top: 0;
    z-index: 5;
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 68px;
  }
  .header__logo {
    text-decoration: none;
    color: var(--ink);
    flex: none;
  }
  .header__logo:hover {
    color: var(--ink);
  }
  .header__nav {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .header__nav a {
    display: block;
    padding: 8px 14px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.97rem;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .header__nav a:hover {
    background: var(--surface);
    color: var(--ink);
  }
  .header__nav a[aria-current='page'] {
    background: var(--ink);
    color: var(--paper);
  }

  @media (max-width: 820px) {
    .header__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-top: 14px;
    }
    nav {
      margin-inline: calc(var(--gutter) * -1);
      overflow-x: auto;
      scrollbar-width: none;
    }
    nav::-webkit-scrollbar {
      display: none;
    }
    .header__nav {
      padding: 10px var(--gutter) 12px;
      width: max-content;
    }
    .header__nav a {
      padding: 7px 12px;
      font-size: 0.92rem;
      border: 1px solid var(--line);
    }
  }
</style>
