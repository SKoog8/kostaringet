---
// Shared layout for /gratis/, category pages and the parents page.
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import CategoryList from './CategoryList.astro';
import OfferGrid from './OfferGrid.astro';
import Illustration from './Illustration.astro';
import SubscribeBox from './SubscribeBox.astro';
import { isActive, type Offer } from '../lib/offers';
import type { CategorySlug } from '../site.config';

interface Props {
  title: string;
  metaTitle: string;
  description: string;
  intro: string;
  offers: Offer[];
  crumbs: { label: string; href: string }[];
  category?: CategorySlug;
  /** Hide the page from search engines (e.g. a category without active offers). */
  noindex?: boolean;
  /** Show a search box that filters the offers on the page. */
  search?: boolean;
  /** Offers shown in their own section above the main grid (slot "featured" holds its heading and text). */
  featured?: Offer[];
  /** Heading for the main grid when a featured section is shown. */
  gridHeading?: string;
}

const { title, metaTitle, description, intro, offers, crumbs, category, noindex = false, search = false, featured = [], gridHeading } = Astro.props;
const active = offers.filter((o) => isActive(o));
const featuredActive = featured.filter((o) => isActive(o));
const rest = active.filter((o) => !featuredActive.includes(o));
const ended = offers.filter((o) => !isActive(o));
---

<Base title={metaTitle} description={description} noindex={noindex}>
  <div class="wrap page-head">
    <div class="page-head__text">
      <Breadcrumbs items={crumbs} />
      <h1>{title}</h1>
      <p class="lead">{intro}</p>
      <p class="count">{active.length} aktiva erbjudanden</p>
    </div>
    {category ? <Illustration cat={category} size="clamp(110px, 18vw, 180px)" /> : <Illustration name="hero" size="clamp(180px, 26vw, 300px)" />}
  </div>

  <div class="wrap">
    {
      search && (
        <div class="search" role="search">
          <label for="sok" class="visually-hidden">Sök bland erbjudandena</label>
          <input
            id="sok"
            type="search"
            placeholder="Sök på företag eller produkt, till exempel BookBeat eller tygprover"
            autocomplete="off"
            enterkeyhint="search"
          />
          <p class="search__status" aria-live="polite"></p>
        </div>
      )
    }
    {
      featuredActive.length > 0 && (
        <section class="featured" id="utvalda">
          <slot name="featured" />
          <OfferGrid offers={featuredActive} itemList adAfter={0} />
        </section>
      )
    }
    <div class="filters">
      <CategoryList current={category} />
    </div>
    {featuredActive.length > 0 && gridHeading && <h2 class="grid-heading">{gridHeading}</h2>}
    <OfferGrid offers={featuredActive.length > 0 ? rest : active} itemList={featuredActive.length === 0} />

    <div class="subscribe">
      <SubscribeBox />
    </div>

    <slot />

    {
      ended.length > 0 && (
        <section class="ended">
          <h2>Nyligen avslutade.</h2>
          <p class="ended__p">Erbjudanden som har gått ut. Vi sparar dem så att du ser vad som brukar komma tillbaka.</p>
          <OfferGrid offers={ended.slice(0, 12)} adAfter={0} />
        </section>
      )
    }
  </div>
</Base>

{
  search && (
    <script>
      // Filters the offer cards on the page as you type. Matches brand, title, description, category and type,
      // and ignores accents, so "lancome" finds Lancôme. The query is kept in ?q= so a search can be linked.
      const input = document.getElementById('sok') as HTMLInputElement | null;
      const status = document.querySelector('.search__status');
      const cards = Array.from(document.querySelectorAll<HTMLElement>('.card[data-search]'));
      const ended = document.querySelector<HTMLElement>('.ended');
      const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
      const texts = cards.map((c) => norm(c.dataset.search ?? ''));
      function run() {
        if (!input) return;
        const words = norm(input.value).split(/\s+/).filter(Boolean);
        let hits = 0;
        cards.forEach((card, i) => {
          const show = words.every((w) => texts[i].includes(w));
          card.hidden = !show;
          if (show && !card.classList.contains('card--ended')) hits++;
        });
        if (ended) ended.hidden = words.length > 0 && !ended.querySelector('.card:not([hidden])');
        if (status) {
          status.textContent = !words.length
            ? ''
            : hits === 0
              ? 'Inga aktiva erbjudanden matchar sökningen.'
              : `${hits} ${hits === 1 ? 'aktivt erbjudande matchar' : 'aktiva erbjudanden matchar'}.`;
        }
        const url = new URL(location.href);
        if (words.length) url.searchParams.set('q', input.value.trim());
        else url.searchParams.delete('q');
        history.replaceState(null, '', url);
      }
      if (input) {
        input.value = new URL(location.href).searchParams.get('q') ?? '';
        input.addEventListener('input', run);
        if (input.value) run();
      }
    </script>
  )
}

<style>
  .featured {
    margin-bottom: 56px;
  }
  .grid-heading {
    margin: 0 0 20px;
  }
  .search {
    display: grid;
    gap: 8px;
    margin-bottom: 20px;
    max-width: 40rem;
  }
  .search input {
    width: 100%;
    font: inherit;
    font-size: 1.05rem;
    padding: 14px 18px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
  }
  .search input:focus {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-color: var(--accent);
  }
  .search__status {
    margin: 0;
    min-height: 1.2em;
    font-size: 0.92rem;
    color: var(--muted);
  }
  .subscribe {
    margin-top: 48px;
  }
  .page-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px 48px;
    padding-block: clamp(32px, 6vw, 72px) 32px;
  }
  .page-head__text {
    display: grid;
    gap: 18px;
    max-width: 48rem;
  }
  @media (max-width: 640px) {
    .page-head {
      flex-direction: column-reverse;
      align-items: flex-start;
    }
  }
  .count {
    font-weight: 600;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .filters {
    margin-bottom: 28px;
  }
  .ended {
    margin-top: 72px;
    display: grid;
    gap: 12px;
  }
  .ended__p {
    color: var(--muted);
    margin-bottom: 12px;
  }
</style>
